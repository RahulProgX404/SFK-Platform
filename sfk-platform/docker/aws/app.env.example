# Laravel settings of the AWS server (docs/deploy-aws.md). Copy to /opt/sfk/app.env on the server, fill in the
# <…> values, then `chmod 600 app.env`. Never commit the filled-in file. No quotes around values (Docker env file).

APP_NAME=SFK Platform
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (on your PC, in the app container); keep it: changing it signs everyone out
APP_KEY=<base64:…>
APP_URL=https://<erp.example.co.jp>
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tokyo
LOG_CHANNEL=stderr
LOG_LEVEL=warning
VIEW_CHECK_CACHE_TIMESTAMPS=false

# RDS PostgreSQL 17 (private, same VPC); sslmode=require — RDS speaks TLS
DB_CONNECTION=pgsql
DB_URL=postgresql://<user>:<password>@<sfk-db.xxxxxxxx.ap-northeast-1.rds.amazonaws.com>:5432/sfk_platform?sslmode=require
DB_PERSISTENT=true

# Redis in the compose project (service "redis"): cache, sessions, queue
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# real time by polling (docs/realtime.md): no WebSocket server
BROADCAST_CONNECTION=null

# only Caddy (same Docker network) reaches the app: its X-Forwarded-* headers are trusted
TRUSTED_PROXIES=*

# uploads in S3; no AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — the EC2 instance role gives the credentials
FILESYSTEM_DISK=local
UPLOADS_DISK=s3
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=<sfk-platform-uploads-xxxx>

# mail through Amazon SES (the sender domain verified in SES; out of the SES sandbox before real use)
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=<no-reply@example.co.jp>
MAIL_FROM_NAME=SFK Platform

# the first administrator, created / kept by the container's start (core:super-admin); remove the password afterwards
SUPER_ADMIN_NAME=システム管理者
SUPER_ADMIN_EMAIL=<admin@example.co.jp>
SUPER_ADMIN_PASSWORD=<a long random password>
